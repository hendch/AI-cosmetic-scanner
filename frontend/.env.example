# n8n scan webhook (POST). From a phone, use your computer's LAN IP, not localhost.
EXPO_PUBLIC_SCAN_URL=http://192.168.1.10:5678/webhook/cosmetic-scanner-live
# n8n status webhook (GET ?request_id=...), used when the scan webhook answers with status "running".
EXPO_PUBLIC_STATUS_URL=http://192.168.1.10:5678/webhook/cosmetic-scanner-status
# Header Auth key configured on the n8n webhook. It ships inside the app bundle, so use a project-only key.
EXPO_PUBLIC_API_KEY=
