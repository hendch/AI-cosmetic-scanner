# n8n scan webhook (POST). From a phone, use your computer's LAN IP, not localhost.
# On Render this is set by render.yaml: https://cosmetic-scanner-n8n.onrender.com/webhook/cosmetic-scanner-live
EXPO_PUBLIC_SCAN_URL=http://192.168.1.10:5678/webhook/cosmetic-scanner-live
# Same value as EXPO_PUBLIC_WEBHOOK_KEY in the root .env. It ships inside the app bundle, so it is public.
EXPO_PUBLIC_WEBHOOK_KEY=
