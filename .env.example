# Copy to .env and fill in:  cp .env.example .env  (never commit .env)
# The same variables are set on Render by render.yaml (secrets in the dashboard).

# --- Keys (generate each with: python -c "import secrets; print(secrets.token_urlsafe(32))") ---
# n8n -> api. When set, every API request except /health needs the header X-API-Key.
SCANNER_API_KEY=
# app -> n8n webhook (also put it in frontend/.env). Public: it ships inside the web app.
EXPO_PUBLIC_WEBHOOK_KEY=

# --- n8n and its database (docker compose) ---
# Never change the encryption key after the first start.
N8N_ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# --- Shared LLM (app/common/llm.py, used by every agent): Hugging Face router ---
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct:featherless-ai
HF_TOKEN=
LLM_TIMEOUT=90
# Label photo OCR (vision model, same router and token)
OCR_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct

# --- RAG embeddings ---
# hf = Hugging Face router with HF_TOKEN (default, no torch). local = sentence-transformers,
# needed only to rebuild the index: EMBEDDING_BACKEND=local python -m app.rag.index
EMBEDDING_BACKEND=hf

# --- Regulatory agent ---
# live | mock (mock = rules only, no LLM)
REGULATORY_MODE=live
# v1 | v2 | v3 | v4
REGULATORY_PROMPT_VERSION=v4
# parallel LLM calls per product
REGULATORY_MAX_PARALLEL=4

# --- Toxicology agent ---
# live | mock (mock = retrieval + rules only, no LLM). The LLM is only called for ingredients with SCCS passages.
TOXICOLOGY_MODE=live
# v2 | v3 | v4 | v5 | v6 | v7 (one request can override it: POST /toxicology/analyze?prompt_version=v6)
TOXICOLOGY_PROMPT_VERSION=v7
TOXICOLOGY_MAX_PARALLEL=4

# --- Retrieval for the regulatory agent ---
# rag = RAG vector index in-process (deployment); http = the RAG endpoint at RETRIEVAL_URL;
# local = reads corpus/regulatory/ directly, no embeddings (tests, offline)
RETRIEVAL_BACKEND=rag
RETRIEVAL_URL=http://localhost:8000
