# Copy to .env and fill in:  cp .env.example .env  (never commit .env)

# n8n / deployment
# Pin n8n: run `docker compose exec n8n n8n --version` once, then put that number here.
N8N_VERSION=latest
# Generate with: openssl rand -hex 16   (never change it after creating credentials)
N8N_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
OLLAMA_MODEL=qwen2.5:7b

# Shared LLM (app/common/llm.py, used by every agent): Qwen 2.5 7B through Hugging Face Inference Providers.
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct:featherless-ai
HF_TOKEN=
LLM_TIMEOUT=90
# Local backup: LLM_BASE_URL=http://localhost:11434/v1 and LLM_MODEL=qwen2.5:7b (no token needed)

# Regulatory agent
REGULATORY_MODE=live            # live | mock (mock = rules only, no LLM)
REGULATORY_PROMPT_VERSION=v4    # v1 | v2 | v3 | v4
REGULATORY_MAX_PARALLEL=4       # parallel LLM calls per product

# Retrieval (Haroun). local = placeholder reading corpus/regulatory/; http = Haroun's service
RETRIEVAL_BACKEND=local
RETRIEVAL_URL=http://localhost:8001
