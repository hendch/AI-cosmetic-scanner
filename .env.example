# Copy to .env (never commit .env). Shared LLM: Qwen 2.5 7B through Hugging Face Inference Providers.
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct:featherless-ai
HF_TOKEN=hf_your_token_here
# Local backup: LLM_BASE_URL=http://localhost:11434/v1 and LLM_MODEL=qwen2.5:7b

# Regulatory agent
REGULATORY_MODE=live            # live | mock (mock = rules only, no LLM)
REGULATORY_PROMPT_VERSION=v4    # v1 | v2 | v3 | v4
REGULATORY_MAX_PARALLEL=4       # parallel LLM calls per product

# Retrieval (Haroun). local = placeholder reading corpus/regulatory/; http = Haroun's service
RETRIEVAL_BACKEND=local
RETRIEVAL_URL=http://localhost:8001
